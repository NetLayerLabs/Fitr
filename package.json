  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets:pose": "node scripts/fetch-pose-assets.mjs",
    "predev": "node scripts/fetch-pose-assets.mjs",
    "prebuild": "node scripts/fetch-pose-assets.mjs",
    "codegen:vault": "node scripts/solana/codegen-vault.mjs",
    "anchor:build": "cd anchor && anchor build",
    "anchor:test": "cd anchor && anchor build && cd programs/fitr-vault && CARGO_RESOLVER_INCOMPATIBLE_RUST_VERSIONS=fallback cargo test"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "@solana-mobile/wallet-standard-mobile": "0.6.0",
    "@solana-program/compute-budget": "0.19.0",
    "@solana-program/system": "0.15.0",
    "@solana-program/token": "0.17.0",
    "@solana-program/token-2022": "0.19.0",
    "@solana/kit": "8.3.0",
    "@solana/react": "8.3.0",
    "@solana/wallet-standard-util": "1.1.4",
    "@wallet-standard/react": "1.0.3",
    "client-only": "0.0.1",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@codama/nodes-from-anchor": "1.5.6",
    "@codama/renderers-js": "2.5.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "codama": "1.11.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "jsdom": "^30.1.1",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
