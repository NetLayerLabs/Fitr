# --- Public (inlined into the client at build time; rebuild after changing) ---------------
# "mainnet" (production, real SKR) or "devnet" (developer test mode with a test SKR mint).
NEXT_PUBLIC_SOLANA_CLUSTER=mainnet
# Devnet only: a test SKR mint you created (spl-token create-token) for the devnet pool.
NEXT_PUBLIC_DEVNET_SKR_MINT=
# Optional override; defaults to the program id baked into the generated vault client.
NEXT_PUBLIC_VAULT_PROGRAM_ID=

# --- Server only (never exposed to the browser) ---------------------------------------------
# Helius API key: the /api/rpc proxy and the attestor send through Helius.
HELIUS_API_KEY=
# Attestor signing key (JSON array of 64 bytes, from `solana-keygen new`). Marks verified
# workouts complete onchain. Keep it out of git; on the VPS store it in the service env file.
ATTESTOR_KEYPAIR=
# Shared secret for the crank endpoint (finalize/close/sweep), called by a cron on the VPS.
CRON_SECRET=

# Server only: folder for small app data that must survive deploys (closed-crews.json).
# Unset in development (kept in memory). On the VPS: /opt/fitr/data.
FITR_DATA_DIR=
